<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="720" prefWidth="1050" minHeight="600" minWidth="900"
            style="-fx-background-color: #f8fafc;"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.complaint.system.controllers.ComplaintController">

    <!-- Top Header -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20"
              style="-fx-background-color: #ffffff; -fx-padding: 16 24; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0;">
            <VBox spacing="3" HBox.hgrow="ALWAYS">
                <Label fx:id="welcomeLabel" text="Welcome, Customer"
                       style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #0f172a;" />
                <Label text="AI-Powered Customer Complaint Portal"
                       style="-fx-font-size: 12px; -fx-text-fill: #64748b;" />
            </VBox>

            <Button text="Logout" onAction="#handleLogout"
                    style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 8 16;" />
        </HBox>
    </top>

    <!-- Center Navigation Tabs -->
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE" style="-fx-padding: 12;">

            <!-- Tab 1: Submit Complaint (Single Input) -->
            <Tab text="Submit Complaint">
                <VBox spacing="16" style="-fx-padding: 24; -fx-background-color: #ffffff; -fx-background-radius: 8;">
                    <VBox spacing="4">
                        <Label text="File a New Complaint"
                               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e3a8a;" />
                        <Label text="Enter your complaint below. Our automated AI engine determines the department, category, and priority."
                               style="-fx-font-size: 12px; -fx-text-fill: #64748b;" />
                    </VBox>

                    <VBox spacing="8">
                        <Label text="Complaint:" style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-size: 14px;" />
                        <TextArea fx:id="complaintInput" prefRowCount="8"
                                  promptText="Describe your complaint here..."
                                  style="-fx-font-size: 13px; -fx-background-radius: 6;" />
                    </VBox>

                    <HBox alignment="CENTER_LEFT" spacing="14">
                        <Button text="Submit Complaint" onAction="#handleSubmit"
                                style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 10 24;" />
                        <Label fx:id="statusLabel" wrapText="true" maxWidth="600" />
                    </HBox>
                </VBox>
            </Tab>

            <!-- Tab 2: Complaint History (Real-Time Agent Updates) -->
            <Tab text="Complaint History">
                <VBox spacing="12" style="-fx-padding: 18; -fx-background-color: #ffffff; -fx-background-radius: 8;">
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label text="My Complaints History"
                               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1e3a8a;" HBox.hgrow="ALWAYS" />
                        <Button text="Refresh Updates" onAction="#loadCustomerComplaints"
                                style="-fx-background-color: #0284c7; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 6 14;" />
                    </HBox>

                    <TableView fx:id="historyTable" VBox.vgrow="ALWAYS"
                               style="-fx-border-color: #cbd5e1; -fx-border-radius: 6;">
                        <columns>
                            <TableColumn fx:id="histIdCol" prefWidth="60" text="ID" />
                            <TableColumn fx:id="histComplaintCol" prefWidth="300" text="Complaint" />
                            <TableColumn fx:id="histDeptCol" prefWidth="150" text="Department" />
                            <TableColumn fx:id="histCategoryCol" prefWidth="120" text="Category" />
                            <TableColumn fx:id="histPriorityCol" prefWidth="90" text="Priority" />
                            <TableColumn fx:id="histStatusCol" prefWidth="100" text="Status" />
                            <TableColumn fx:id="histNotesCol" prefWidth="250" text="Agent Progress Notes" />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>
                </VBox>
            </Tab>

            <!-- Tab 3: Analytics -->
            <Tab text="Analytics">
                <HBox spacing="16" style="-fx-padding: 18; -fx-background-color: #ffffff; -fx-background-radius: 8;">
                    <PieChart fx:id="statusPieChart" title="Complaints by Status" HBox.hgrow="ALWAYS" />
                    <BarChart fx:id="deptBarChart" title="Complaints by Department" HBox.hgrow="ALWAYS">
                        <xAxis><CategoryAxis label="Department" /></xAxis>
                        <yAxis><NumberAxis label="Count" /></yAxis>
                    </BarChart>
                </HBox>
            </Tab>

        </TabPane>
    </center>

</BorderPane>