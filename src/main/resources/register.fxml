<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="12.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.complaint.system.controllers.RegisterController" style="-fx-background-color: #f8fafc;">
    <padding>
        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0"/>
    </padding>

    <Label text="Customer Registration" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
    <Label text="Create a new account to file and track complaints" style="-fx-font-size: 12px; -fx-text-fill: #64748b;"/>

    <GridPane hgap="10" vgap="10" alignment="CENTER">
        <Label text="Full Name:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="nameField" promptText="Enter full name" prefWidth="250" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="emailField" promptText="Enter email address" prefWidth="250" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label text="Phone:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="phoneField" promptText="Enter phone number" prefWidth="250" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

        <Label text="Password:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <PasswordField fx:id="passwordField" promptText="Min 6 characters" prefWidth="250" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

        <Label text="Confirm Pass:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
        <PasswordField fx:id="confirmPasswordField" promptText="Repeat password" prefWidth="250" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
    </GridPane>

    <Button text="Register Account" onAction="#handleRegister" prefWidth="250" style="-fx-background-color: #059669; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8px;"/>

    <Hyperlink text="Already have an account? Login here" onAction="#handleBackToLogin" style="-fx-text-fill: #0284c7; -fx-font-size: 12px;"/>

    <Label fx:id="messageLabel" visible="false" wrapText="true"/>
</VBox>