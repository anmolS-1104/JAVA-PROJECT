<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="15" prefWidth="420" prefHeight="480"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.complaint.system.controllers.LoginController"
      style="-fx-background-color: #0f172a; -fx-padding: 30;">

    <Label text="Company CMS Portal" style="-fx-text-fill: #38bdf8; -fx-font-size: 22px; -fx-font-weight: bold;" />

    <Label text="Select User Role" style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;" />
    <ComboBox fx:id="roleComboBox" prefWidth="300" />

    <TextField fx:id="emailField" promptText="Email Address" prefWidth="300" />
    <PasswordField fx:id="passwordField" promptText="Password" prefWidth="300" />

    <Label fx:id="messageLabel" visible="false" managed="false" />

    <Button text="Sign In" onAction="#handleLogin" prefWidth="300"
            style="-fx-background-color: #0284c7; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10;" />

    <Hyperlink fx:id="registerLink" text="New Customer? Register here" onAction="#handleOpenRegister"
               style="-fx-text-fill: #38bdf8;" />
</VBox>